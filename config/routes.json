{
  "routes": [
    {
      "request": "GET",
      "path": "/form-viewer",
      "controller": "form_viewer\\FormViewerController",
      "method": "menu"
    },
    {
      "request": "GET",
      "path": "/form-viewer/create/pdf/{form_id}/answers/{uniq_code}",
      "controller": "form_viewer\\FormViewerController",
      "method": "createPDF"
    },
    {
      "request": "POST",
      "path": "/form-viewer/forms/database/delete/answers",
      "controller": "form_viewer\\FormViewerCrudController",
      "method": "deleteAnswersDatabase"
    },
    {
      "request": "POST",
      "path": "/form-viewer/forms/delete/answers",
      "controller": "form_viewer\\FormViewerCrudController",
      "method": "deleteAnswers"
    },
    {
      "request": "GET",
      "path": "/form-viewer/forms/{form_id}",
      "controller": "form_viewer\\FormViewerController",
      "method": "index"
    },
    {
      "request": "GET",
      "path": "/form-viewer/forms/{form_id}/answers/{uniq_code}",
      "controller": "form_viewer\\FormViewerController",
      "method": "viewAnswer"
    },
    {
      "request": "GET",
      "path": "/form-viewer/get/form-access",
      "controller": "form_viewer\\FormViewerCrudController",
      "method": "getFormAccess"
    },
    {
      "request": "GET",
      "path": "/form-viewer/qr/{id}",
      "controller": "form_viewer\\FormViewerController",
      "method": "showQr"
    },
    {
      "request": "GET",
      "path": "/form-viewer/external-qr/{id}",
      "controller": "form_viewer\\FormViewerController",
      "method": "showExternalQr"
    },
    {
      "request": "GET",
      "path": "/form-viewer/settings",
      "controller": "form_viewer\\FormViewerSettingsController",
      "method": "settings"
    },
    {
      "request": "POST",
      "path": "/form-viewer/settings/add/form-access",
      "controller": "form_viewer\\FormViewerCrudController",
      "method": "addFormAccess"
    },
    {
      "request": "POST",
      "path": "/form-viewer/settings/add/user-access",
      "controller": "form_viewer\\FormViewerCrudController",
      "method": "addUserAccess"
    },
    {
      "request": "POST",
      "path": "/form-viewer/settings/remove/form-access",
      "controller": "form_viewer\\FormViewerCrudController",
      "method": "removeFormAccess"
    },
    {
      "request": "POST",
      "path": "/form-viewer/settings/remove/user-access",
      "controller": "form_viewer\\FormViewerCrudController",
      "method": "removeUserAccess"
    }
  ]
}