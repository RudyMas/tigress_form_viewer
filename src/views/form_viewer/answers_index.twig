{% extends 'datatable.twig' %}
{% block js %}
    {{ parent() }}
    <script>
        let variables = {
            formId: '{{ form.id }}',
            access: '{{ rights.access }}',
            write: '{{ rights.write }}',
            read: '{{ rights.read }}',
            delete: '{{ rights.delete }}',
        }
        let language = {
            translations: {{ translations|json_encode|raw }},
        }
    </script>
    <script src="{{ BASE_URL }}/vendor/tigress/form-viewer/public/javascript/form_viewer/answers_index.js"></script>
{% endblock %}
{% block title %}{{ __('Forms') }} - {{ __('Overview') }}{% endblock %}
{% block breadcrumb %}
    <div class="row mb-2">
        <div class="col-md-12">
            <nav aria-label="breadcrumb" data-bs-theme="{{ WEBSITE.mode }}">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ BASE_URL }}/"><i class="fa fa-home"></i></a></li>
                    <li class="breadcrumb-item"><a href="{{ BASE_URL }}/form-viewer">{{ __('Forms') }}</a></li>
                    <li class="breadcrumb-item active">{{ __('Overview') }} - {{ form.name }}</li>
                </ol>
            </nav>
        </div>
    </div>
{% endblock %}
{% block content %}
    <div class="container">
        <div class="row mb-2">
            <div class="col-sm-8">
                <h3>{{ __('Overview') }} - {{ form.name }}</h3>
            </div>
            <div class="col-sm-4 text-end">
                <a class="btn btn-sm btn-secondary" href="{{ BASE_URL }}/form-viewer/external-qr/{{ form.id }}">
                    <i class="fa-solid fa-qrcode"></i> {{ __('External QR-code') }}
                </a>
                <a class="btn btn-sm btn-secondary" href="{{ BASE_URL }}/form-viewer/qr/{{ form.id }}">
                    <i class="fa-solid fa-qrcode"></i> {{ __('QR-code') }}
                </a>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-md-12">
                <fieldset class="mt-2">
                    <div class="row mb-2">
                        <div class="col-sm-12 table-responsive">
                            <table id="dataTableAnswers" class="table table-striped table-bordered"></table>
                        </div>
                    </div>
                </fieldset>
            </div>
        </div>
    </div>

    {# Modal Delete Form #}
    <form action="{{ BASE_URL }}/form-viewer/forms/delete/answers" method="post" enctype="multipart/form-data">
        <div class="modal fade" id="modalDelete" tabindex="-1" aria-labelledby="modalDeleteLabel"
             aria-hidden="true" style="color: black">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalDeleteLabel">{{ __('Removing form answers') }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ __('Close') }}"></button>
                    </div>
                    <div class="modal-body">
                        <p>{{ __('Are you sure you want to delete the answers for this form?') }}</p>
                    </div>
                    <div class="modal-footer">
                        <input type="hidden" name="id" id="id">
                        <input type="hidden" name="form_id" value="{{ form.id }}">
                        <button type="submit" class="btn btn-success" id="btnArchiveren">{{ __('Delete') }}</button>
                        <button type="button" class="btn btn-danger" data-bs-dismiss="modal">{{ __('Cancel') }}</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
{% endblock %}